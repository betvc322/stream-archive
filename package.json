{
  "name": "stream-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run sync && next dev --hostname 0.0.0.0",
    "sync": "node --experimental-strip-types scripts/sync-catalog.ts",
    "build": "npm run sync && next build && node scripts/verify-export.mjs",
    "start": "node scripts/serve-export.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.0"
  }
}
